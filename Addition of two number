#include <stdio.h>

int main() {
    int num1, num2, sum;
    
    // Taking input from user
    printf("Enter first number: ");
    scanf("%d", &num1);
    
    printf("Enter second number: ");
    scanf("%d", &num2);
    
    // Adding two numbers
    sum = num1 + num2;
    
    // Displaying result
    printf("Addition of %d and %d is: %d\n", num1, num2, sum);
    
    return 0;
}
