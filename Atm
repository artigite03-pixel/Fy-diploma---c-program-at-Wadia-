#include <stdio.h>
int main() {
    int choice, balance = 10000, amount;
    printf("1. Check Balance\n2. Deposit\n3. Withdraw\nEnter choice: ");
    scanf("%d", &choice);
    switch(choice) {
        case 1: printf("Balance: %d\n", balance); break;
        case 2: 
            printf("Deposit amount: ");
            scanf("%d", &amount);
            balance += amount;
            printf("New Balance: %d\n", balance); break;
        case 3:
            printf("Withdraw amount: ");
            scanf("%d", &amount);
            if(amount <= balance) {
                balance -= amount;
                printf("New Balance: %d\n", balance);
            } else printf("Insufficient funds!\n");
            break;
    }
    return 0;
}
